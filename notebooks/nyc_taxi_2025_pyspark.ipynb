# 1. Tải repo từ GitHub về máy
git clone https://github.com/<ten-tai-khoan>/<ten-repo>.git
cd <ten-repo>

# 2. Kiểm tra trạng thái các file đã thay đổi/thêm mới
git status

# 3. Đưa file vào vùng chuẩn bị commit (ví dụ thêm toàn bộ)
git add .

# 4. Lưu thay đổi kèm lời nhắn mô tả
git commit -m "Update data cleaning and visualization"

# 5. Đẩy lên GitHub
git push origin main
